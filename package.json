{
	"name": "supashop",
	"description": "Single-store delivery app built with React, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Supashop delivery app",
		"products": [
			"Workers",
			"D1",
			"R2"
		],
		"categories": [
			"ecommerce"
		]
	},
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"dependencies": {
		"@heroicons/react": "^2.2.0",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "^1.6.26",
		"drizzle-orm": "^0.45.2",
		"hono": "4.11.1",
		"qrcode": "^1.5.4",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router-dom": "^7.18.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.3",
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@eslint/js": "9.39.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "24.10.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"jsdom": "^27.4.0",
		"tailwindcss": "^4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.10",
		"wrangler": "4.120.0"
	},
	"packageManager": "pnpm@11.20.0",
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:worker && pnpm build && wrangler deploy --dry-run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply supashop-db --local",
		"dev": "vite",
		"lint": "eslint .",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"test:worker": "vitest run --config vitest.worker.config.ts",
		"test:e2e": "playwright test",
		"typecheck": "tsc -b",
		"deploy": "wrangler deploy",
		"preview": "pnpm build && vite preview"
	},
	"type": "module"
}
